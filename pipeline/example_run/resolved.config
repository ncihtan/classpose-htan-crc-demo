params {
   input = 'https://raw.githubusercontent.com/adamjtaylor/nf-classpose/refs/heads/main/test/drs_samplesheet.csv'
   outdir = 's3://htan-project-tower-bucket/nf-classpose/outputs/drs_test/'
   model_config = 'conic'
   roi_geojson = null
   tissue_detection_model_path = '/root/.grandqc_models/tissue/Tissue_Detection_MPP10.pth'
   artefact_detection_model_path = '/root/.grandqc_models/artefact/GrandQC_MPP15.pth'
   filter_artefacts = false
   batch_size = 8
   device = null
   bf16 = false
   tta = false
   tile_size = 1024
   overlap = 64
   output_type = 'csv spatialdata'
   vips_compression = 'jpeg'
   gen3_credentials = 's3://htan-project-tower-bucket/nf-classpose/credentials.json'
   gen3_profile = 'htan'
   gen3_api_endpoint = 'https://nci-crdc.datacommons.io'
}

process {
   cpus = { 4 * task.attempt }
   memory = { 16.GB * task.attempt }
   time = { 4.h * task.attempt }
   errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
   maxRetries = 2
   maxErrors = '-1'
   container = 'ghcr.io/adamjtaylor/nf-classpose:latest'
   withLabel:process_low {
      cpus = 2
      memory = '8 GB'
      time = '2h'
   }
   withLabel:process_medium {
      cpus = 4
      memory = '16 GB'
      time = '4h'
   }
   withLabel:process_high {
      cpus = 8
      memory = '32 GB'
      time = '8h'
   }
   withLabel:process_gpu {
      cpus = 4
      memory = { 32.GB * Math.min(task.attempt, 2) }
      time = '8h'
      accelerator = 1
   }
   withName:VIPS_CONVERT {
      container = 'ghcr.io/adamjtaylor/nf-classpose-vips:main'
   }
   withName:GEN3_DOWNLOAD {
      container = 'ghcr.io/adamjtaylor/nf-classpose-gen3:latest'
   }
   shell = ['/bin/bash', '-euo', 'pipefail']
   executor = 'awsbatch'
   queue = 'TowerForge-4Ktj0aKlR4KmvtpjUe195F-work'
   resourceLabels = [CostCenter:'120100', Project:'Human_Tumor_Atlas_Network', TowerProject:'htan-project', Department:'SCCE', OwnerEmail:'adam_taylor_sagebase_org']
}

timeline {
   enabled = true
   file = 'timeline-3stNqO29UUEC1M.html'
}

report {
   enabled = true
   file = 's3://htan-project-tower-bucket/nf-classpose/outputs/drs_test//pipeline_info/execution_report_2026-01-25_11-05-36.html'
}

trace {
   enabled = true
   file = 's3://htan-project-tower-bucket/nf-classpose/outputs/drs_test//pipeline_info/execution_trace_2026-01-25_11-05-36.txt'
}

dag {
   enabled = true
   file = 's3://htan-project-tower-bucket/nf-classpose/outputs/drs_test//pipeline_info/pipeline_dag_2026-01-25_11-05-36.svg'
}

manifest {
   name = 'nf-classpose'
   author = ''
   homePage = 'https://github.com/adamjtaylor/nf-classpose'
   description = 'Nextflow wrapper for Classpose WSI cell classification'
   mainScript = 'main.nf'
   nextflowVersion = '!>=23.04.0'
   version = '1.0.0'
}

aws {
   region = 'us-east-1'
   client {
      uploadChunkSize = 10485760
   }
   batch {
      maxSpotAttempts = 0
      cliPath = '/home/ec2-user/miniconda/bin/aws'
      jobRole = 'arn:aws:iam::728882028485:role/htan-project-TowerForgeBatchWorkJobRole-17360PQARGWYU'
      executionRole = 'arn:aws:iam::728882028485:role/htan-project-TowerForgeBatchExecutionRole-1UXCTPH340O9L'
   }
}

workDir = 's3://htan-project-tower-scratch/work'

wave {
   enabled = true
   endpoint = 'https://wave.seqera.io'
}

runName = 'fabulous_faggin'

tower {
   enabled = true
   endpoint = 'https://tower.sagebionetworks.org/api'
}

cloudcache {
   enabled = true
   path = 's3://htan-project-tower-scratch/work/.cache'
}
